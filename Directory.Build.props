<Project>
  <PropertyGroup>
    <!-- Keep existing deployments on Framework unless the entire solution opts into .NET 8. -->
    <BuildNet481 Condition="'$(BuildNet481)' == '' and '$(BuildNet8)' != 'true' and '$(MSBuildProjectName)' != 'libCanopenSimple'">true</BuildNet481>
    <SolutionDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)CanMonitor\</SolutionDir>
  </PropertyGroup>
</Project>
