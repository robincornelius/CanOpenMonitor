<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ConformanceTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputPath>build\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>build\obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WeifenLuo.WinFormsUI.Docking">
      <HintPath>..\packages\DockPanelSuite.3.1.1\lib\net40\WeifenLuo.WinFormsUI.Docking.dll</HintPath>
    </Reference>
    <Compile Include="ConformanceTests.cs" />
    <Compile Include="..\CanMonitor\PluginManager.cs" />
    <ProjectReference Include="..\ConformancePlugin\ConformancePlugin.csproj">
      <Name>ConformancePlugin</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\..\libCanOpenSimple2\libCanopenSimple.csproj">
      <Name>libCanopenSimple</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\..\libeds\libEDSsharp\libEDSsharp.csproj">
      <Name>libEDSsharp</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\PDOInterface\PDOInterface.csproj">
      <Name>PDOInterface</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
