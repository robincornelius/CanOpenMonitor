<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PdoEditorTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputPath>build\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>build\obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Compile Include="..\SDOEditorPlugin\PdoEditorModel.cs" />
    <Compile Include="..\SDOEditorPlugin\PdoEditorForm.cs" />
    <Compile Include="PdoEditorTests.cs" />
    <Compile Include="..\SDOEditorPlugin\OdIntegerDisplay.cs" />
    <Compile Include="..\SDOEditorPlugin\OdValueComparison.cs" />
    <Compile Include="..\SDOEditorPlugin\RecentDeviceFiles.cs" />
    <ProjectReference Include="..\..\libCanOpenSimple2\libCanopenSimple.csproj"><Name>libCanopenSimple</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform></ProjectReference>
    <ProjectReference Include="..\..\libeds\libEDSsharp\libEDSsharp.csproj"><Name>libEDSsharp</Name><SetPlatform Condition="'$(Platform)' == 'x86'">Platform=AnyCPU</SetPlatform></ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
